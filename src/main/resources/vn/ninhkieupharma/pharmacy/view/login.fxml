<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.ninhkieupharma.pharmacy.controller.LoginController"
      styleClass="login-root">
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="24.0" styleClass="login-brand-panel">
        <padding><Insets top="48.0" right="56.0" bottom="48.0" left="56.0"/></padding>
        <Label text="NK" styleClass="brand-mark-large"/>
        <VBox spacing="10.0">
            <Label text="Ninh Kieu Pharma" styleClass="login-brand-title"/>
            <Label text="Hệ thống quản lý vận hành nhà thuốc"
                   styleClass="login-brand-subtitle" wrapText="true"/>
        </VBox>
        <VBox spacing="12.0" styleClass="login-benefits">
            <Label text="Quản lý nhân sự và ca làm" styleClass="login-benefit"/>
            <Label text="Theo dõi sản phẩm và tồn kho" styleClass="login-benefit"/>
            <Label text="Bán hàng và chăm sóc khách hàng" styleClass="login-benefit"/>
        </VBox>
        <Label text="Có dữ liệu mẫu để xem trước giao diện — không lưu dữ liệu thật"
               styleClass="login-note" wrapText="true"/>
    </VBox>
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="login-form-side">
        <VBox maxWidth="430.0" spacing="22.0" styleClass="login-card">
            <VBox spacing="8.0">
                <Label text="Chào mừng trở lại" styleClass="login-title"/>
                <Label text="Đăng nhập để tiếp tục làm việc" styleClass="muted-text"/>
            </VBox>
            <VBox spacing="8.0">
                <Label text="Tên đăng nhập" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập"
                           styleClass="text-input"/>
            </VBox>
            <VBox spacing="8.0">
                <Label text="Mật khẩu" styleClass="field-label"/>
                <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu"
                               styleClass="text-input"/>
            </VBox>
            <VBox spacing="8.0">
                <Label text="Vai trò giao diện" styleClass="field-label"/>
                <ComboBox fx:id="roleComboBox" maxWidth="Infinity" styleClass="text-input"/>
            </VBox>
            <Label fx:id="errorLabel" managed="false" visible="false"
                   styleClass="form-error" wrapText="true"/>
            <Button text="Đăng nhập" onAction="#handleLogin"
                    maxWidth="Infinity" styleClass="button-primary login-submit"/>
            <Label text="Bạn có thể nhập thông tin bất kỳ để xem bản giao diện."
                   styleClass="helper-text" wrapText="true"/>
        </VBox>
    </VBox>
</HBox>
