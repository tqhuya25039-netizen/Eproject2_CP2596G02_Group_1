<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vn.ninhkieupharma.pharmacy.auth.controller.LoginController"
      styleClass="login-root">
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT" spacing="24.0" styleClass="login-brand-panel">
        <padding><Insets top="48.0" right="56.0" bottom="48.0" left="56.0"/></padding>
        <Label text="NK" styleClass="brand-mark-large"/>
        <VBox spacing="10.0">
            <Label text="Ninh Kieu Pharma" styleClass="login-brand-title"/>
            <Label fx:id="brandSubtitleLabel" text="Hệ thống quản lý vận hành nhà thuốc"
                   styleClass="login-brand-subtitle" wrapText="true"/>
        </VBox>
        <VBox spacing="12.0" styleClass="login-benefits">
            <Label fx:id="staffBenefitLabel" text="Quản lý nhân sự và ca làm" styleClass="login-benefit"/>
            <Label fx:id="inventoryBenefitLabel" text="Theo dõi sản phẩm và tồn kho" styleClass="login-benefit"/>
            <Label fx:id="salesBenefitLabel" text="Bán hàng và chăm sóc khách hàng" styleClass="login-benefit"/>
        </VBox>
        <Label fx:id="sampleNoteLabel" text="Có dữ liệu mẫu để xem trước giao diện — không lưu dữ liệu thật"
               styleClass="login-note" wrapText="true"/>
        <Button fx:id="languageButton" text="English" onAction="#handleToggleLanguage"
                styleClass="button-secondary"/>
    </VBox>
    <VBox HBox.hgrow="ALWAYS" alignment="CENTER" styleClass="login-form-side">
        <VBox maxWidth="430.0" spacing="22.0" styleClass="login-card">
            <VBox spacing="8.0">
                <Label fx:id="welcomeLabel" text="Chào mừng trở lại" styleClass="login-title"/>
                <Label fx:id="loginSubtitleLabel" text="Đăng nhập để tiếp tục làm việc" styleClass="muted-text"/>
            </VBox>
            <VBox spacing="8.0">
                <Label fx:id="usernameLabel" text="Tên đăng nhập" styleClass="field-label"/>
                <TextField fx:id="usernameField" promptText="Nhập tên đăng nhập"
                           styleClass="text-input"/>
            </VBox>
            <VBox spacing="8.0">
                <Label fx:id="passwordLabel" text="Mật khẩu" styleClass="field-label"/>
                <HBox spacing="8.0">
                    <StackPane HBox.hgrow="ALWAYS">
                        <PasswordField fx:id="passwordField" promptText="Nhập mật khẩu"
                                       styleClass="text-input"/>
                        <TextField fx:id="visiblePasswordField" promptText="Nhập mật khẩu"
                                   styleClass="text-input" visible="false" managed="false"/>
                    </StackPane>
                    <Button fx:id="passwordVisibilityButton" text="Hiện"
                            onAction="#handleTogglePasswordVisibility"
                            styleClass="button-secondary"/>
                </HBox>
            </VBox>
            <Label fx:id="errorLabel" managed="false" visible="false"
                   styleClass="form-error" wrapText="true"/>
            <Button fx:id="loginButton" text="Đăng nhập" onAction="#handleLogin"
                    maxWidth="Infinity" styleClass="button-primary login-submit"/>
            <Label fx:id="helperLabel" text="Thông tin đăng nhập được xác thực với tài khoản đã lưu trong MySQL."
                   styleClass="helper-text" wrapText="true"/>
        </VBox>
    </VBox>
</HBox>
