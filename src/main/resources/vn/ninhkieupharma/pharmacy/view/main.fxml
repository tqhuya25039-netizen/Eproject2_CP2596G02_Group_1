<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="vn.ninhkieupharma.pharmacy.features.common.controller.MainController"
            fx:id="root" styleClass="app-root">
    <left>
        <VBox prefWidth="270.0" styleClass="sidebar">
            <VBox spacing="14.0" styleClass="sidebar-brand">
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="NK" styleClass="brand-mark"/>
                    <VBox spacing="2.0">
                        <Label text="Ninh Kieu Pharma" styleClass="brand-name"/>
                        <Label fx:id="brandCaptionLabel" text="QUẢN LÝ NHÀ THUỐC" styleClass="brand-caption"/>
                    </VBox>
                </HBox>
            </VBox>
            <Separator/>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="nav-scroll">
                <content>
                    <VBox fx:id="navigation" spacing="8.0" styleClass="navigation"/>
                </content>
            </ScrollPane>
            <VBox spacing="12.0" styleClass="sidebar-footer">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="●" styleClass="online-dot"/>
                    <VBox spacing="2.0">
                        <Label fx:id="userNameLabel" text="Người dùng" styleClass="sidebar-user"/>
                        <Label fx:id="roleLabel" text="Vai trò" styleClass="sidebar-role"/>
                    </VBox>
                </HBox>
                <Button fx:id="logoutButton" text="Đăng xuất" onAction="#handleLogout"
                        maxWidth="Infinity" styleClass="button-logout"/>
            </VBox>
        </VBox>
    </left>
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="topbar">
            <Label fx:id="breadcrumbLabel" text="Tổng quan" styleClass="topbar-title"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="languageButton" text="English" onAction="#handleToggleLanguage"
                    styleClass="button-secondary"/>
            <Label fx:id="demoBadgeLabel" text="MYSQL" styleClass="demo-badge"/>
        </HBox>
    </top>
    <center>
        <StackPane fx:id="contentHost" styleClass="content-host"/>
    </center>
</BorderPane>
