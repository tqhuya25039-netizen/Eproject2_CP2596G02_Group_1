|User|
start
:Select Supplier Information;
|System|
if (Admin or Staff?) then (Yes)
  :Load supplier records from MySQL;
  :Display the supplier list;
|User|
  :Select an operation;
  if (Create?) then (Yes)
    if (Admin?) then (Yes)
      :Enter supplier code, name, phone,\nemail, address, and status;
      |System|
      :Validate the supplier data;
      if (Data valid?) then (Yes)
        :Insert the supplier record into MySQL;
        :Display success and refresh the list;
      else (No)
        :Display validation errors;
      endif
    else (No)
      :Deny create operation;
    endif
  elseif (Read?) then (Yes)
    :Search or select a supplier;
    |System|
    :Retrieve and display matching suppliers from MySQL;
  elseif (Update?) then (Yes)
    if (Admin?) then (Yes)
      |User|
      :Select a supplier and edit its details;
      |System|
      :Validate the updated data;
      if (Data valid?) then (Yes)
        :Update the supplier record in MySQL;
        :Display success and refresh the list;
      else (No)
        :Display validation errors;
      endif
    else (No)
      :Deny update operation;
    endif
  elseif (Delete?) then (Yes)
    if (Admin?) then (Yes)
      |User|
      :Select a supplier and confirm deletion;
      |System|
      :Delete supplier-product links and supplier\nin a transaction;
      :Display the result and refresh the list;
    else (No)
      :Deny delete operation;
    endif
  else (Cancel)
    |User|
    :Close Supplier Information;
  endif
else (No)
  |System|
  :Deny module access;
endif
|User|
stop
@enduml

@startuml
title 9. Generate Reports (UC-10 & UC-11)

!pragma useVerticalIf on
skinparam defaultFontSize 20
skinparam shadowing false
skinparam activity {
  BackgroundColor #F8FAFC
  BorderColor #1E40AF
  FontColor #1F2937
  DiamondBackgroundColor #FFFFFF
  DiamondBorderColor #1E40AF
  StartColor #1F2937
  EndColor #1F2937
}

|User|
start
:Select Supplier Distribution Report;
|System|
if (Admin access?) then (Yes)
  |User|
  :Select a report type;
  if (Product category trend?) then (UC-10)
    |System|
    :Load active products grouped by quarter and category;
    :Calculate product, dosage-form, and supplier counts;
    :Calculate each category's share within its quarter;
    :Assess replacement options:\n5+ products and 2+ suppliers = many;\n2+ products = basic; otherwise = few;
    :Display the quarterly report table and charts;
    |User|
    :Filter by quarter or category,\nor refresh the report;
    |System|
    :Apply filters or reload report data from MySQL;
    :Notify user that file export is not implemented;
  elseif (Supplier distribution?) then (UC-11)
    |System|
    :Load received goods-receipt items,\ngrouped by month, supplier, and product;
    :Count distinct products per supplier\nfor each month;
    :Calculate each supplier's share using\nthe month's distinct products as denominator;
    :Classify dependency: High (>= 50%),\nMedium (>= 25%), or Low (< 25%);
    :Highlight balanced sourcing or\nconcentration on specific suppliers;
    :Display the monthly report table and charts;
    |User|
    :Filter by month or supplier,\nor refresh the report;
    |System|
    :Apply filters or reload report data from MySQL;
    :Notify user that file export is not implemented;
  else (Cancel)
    |User|
    :Close the reports;
  endif
else (No)
  :Deny access (Staff cannot access this module);
endif
stop

@enduml
